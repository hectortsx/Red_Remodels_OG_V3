PORT=4173
HOST=0.0.0.0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

MAIL_FROM="Red Remodels <hello@redremodels.com>"
MAIL_TO=hello@redremodels.com
MAIL_CC=hector@savio.design
MAIL_SUBJECT=Red Remodels website: info request
MAIL_CONFIRMATION_ENABLED=true
MAIL_CONFIRMATION_SUBJECT=Thanks for contacting Red Remodels
MAIL_CONFIRMATION_MESSAGE=Hi {{name}},\n\nThanks for reaching out to Red Remodels. We received your message and will be in touch soon.\n\nTalk soon,\nThe Red Remodels Team

TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.redremodels.com,redremodels.com
# Public sitekey is configured in public/assets/js/contact-form-config.js.
# Use official test keys only in isolated local tests; never production.

RATE_LIMIT_MAX=10
CORS_ORIGIN=https://www.redremodels.com
