{
  "name": "red-remodels-og-v3",
  "version": "1.0.0",
  "private": true,
  "description": "Static site assets for Red Remodels. Provides local dev server for previewing the site.",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "build:blog": "node scripts/build-blog.js",
    "test:contact-guard": "node --experimental-vm-modules --test scripts/tests/contact-origin-guard.test.mjs",
    "test:contact": "node --experimental-vm-modules --test scripts/tests/contact-origin-guard.test.mjs scripts/tests/contact-turnstile.test.mjs scripts/tests/contact-form-turnstile.test.mjs",
    "test:privacy": "node --test scripts/tests/cookie-preferences.test.mjs",
    "waf:baseline": "node scripts/capture-waf-baseline.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^17.0.4"
  }
}
