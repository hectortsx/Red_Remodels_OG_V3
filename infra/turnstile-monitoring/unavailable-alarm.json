{
  "AlarmName": "redremodels-turnstile-unavailable",
  "AlarmDescription": "Turnstile verification service/network failure; inspect provider status and safe logs.",
  "ActionsEnabled": true,
  "AlarmActions": [
    "arn:aws:sns:us-east-1:365608889294:redremodels-alerts"
  ],
  "Namespace": "RedRemodels/Contact",
  "MetricName": "TurnstileUnavailable",
  "Statistic": "Sum",
  "Unit": "Count",
  "Period": 300,
  "EvaluationPeriods": 1,
  "DatapointsToAlarm": 1,
  "Threshold": 1,
  "ComparisonOperator": "GreaterThanOrEqualToThreshold",
  "TreatMissingData": "notBreaching"
}
